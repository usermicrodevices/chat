{
  "logging": {
    "port": 8082,
    "console": true,
    "level": "trace",
    "file": "logs/chat.log",
    "max_files": 3,
    "max_file_size": 10485760,
    "pattern": "[%Y-%m-%d %H:%M:%S.%e] [%P] [%^%l%$] [%n] %v"
  },
  "serialization": {
    "db_path": "chat.db"
  },
  "master": {
    "num_tasks": 3,
    "worker_socket_path": "/tmp/chat_worker.sock"
  },
  "worker": {
    "listen_address": "0.0.0.0",
    "listen_port": 8080,
    "num_io_threads": 2,
    "max_connections": 1000
  }
}
